FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

RUN apt-get update && apt-get install -y software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.12 python3.12-venv python3-pip \
    git wget curl \
    libegl1 libgles2 libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip

RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu128

RUN pip install --no-cache-dir \
    warp-lang \
    huggingface_hub \
    esdk-obs-python \
    requests \
    opencv-python-headless \
    gymnasium \
    "numpy<3"

RUN pip install --no-cache-dir \
    "git+https://github.com/google-deepmind/mujoco_warp.git@v3.9.0.1" \
    "git+https://github.com/huggingface/lerobot.git" \
    "so101-nexus[warp,train] @ git+https://github.com/johnsutor/so101-nexus.git"

ENV MUJOCO_GL=egl
ENV HF_ENDPOINT=https://hf-mirror.com

WORKDIR /data/pipeline
COPY scripts/ /scripts/
