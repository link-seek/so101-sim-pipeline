FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    git wget curl build-essential \
    libegl1 libgles2 libgl1-mesa-glx \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

# uv: required by `vla-eval serve` to spawn model servers
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN cd /tmp && \
    wget -q https://www.sqlite.org/2024/sqlite-autoconf-3450000.tar.gz && \
    tar xzf sqlite-autoconf-3450000.tar.gz && \
    cd sqlite-autoconf-3450000 && \
    ./configure --prefix=/usr/local && make -j4 && make install && \
    ldconfig && rm -rf /tmp/sqlite-autoconf-3450000*

RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# Prefer /usr/local sqlite (3.45, built above) over Ubuntu 22.04 system 3.37:
# vla-eval>=0.4 requires SQLite>=3.38 (json_patch). LD_LIBRARY_PATH is
# resolved before the ld cache, so this beats cache-order issues.
ENV LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Fail the build (not the GPU run) if sqlite is still too old.
RUN python -c "import sqlite3; v=tuple(map(int, sqlite3.sqlite_version.split('.')))[:3]; assert v >= (3, 38, 0), sqlite3.sqlite_version; print('sqlite check OK:', sqlite3.sqlite_version)"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

RUN pip install --no-cache-dir \
    torch==2.11.0 torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu126

RUN pip install --no-cache-dir \
    "lerobot[smolvla]==0.6.1"

RUN pip install --no-cache-dir \
    vla-eval==0.4.0 \
    mujoco==3.3.2 \
    opencv-python

ENV MUJOCO_GL=egl
ENV HF_ENDPOINT=https://hf-mirror.com
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

WORKDIR /workspace
COPY scripts/ /workspace/scripts/
COPY configs/ /workspace/configs/

# `vla-eval serve` runs the server script via `uv run <script>`. Make uv reuse
# this venv (not a fresh python) and stage the server script with its PEP 723
# metadata stripped (upstream pins CPU torch + git lerobot, which would shadow
# this image's CUDA venv; all deps are already installed here).
ENV VIRTUAL_ENV=/opt/venv
ENV UV_NO_PROJECT=1
RUN SITE_PKGS=$(python -c "import site; print(site.getsitepackages()[0])") && \
    mkdir -p /workspace/model_servers && \
    sed '/^# \/\/\/ script/,/^# \/\/\/$/d' "$SITE_PKGS/vla_eval/model_servers/lerobot.py" \
      > /workspace/model_servers/lerobot.py && \
    grep -c "PEP 723\|/// script" /workspace/model_servers/lerobot.py || \
      echo "server script staged OK (metadata stripped)"

CMD ["python", "/workspace/scripts/eval_vla.py"]
