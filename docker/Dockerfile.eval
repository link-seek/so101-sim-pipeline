FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    git wget curl build-essential \
    libegl1 libegl-dev libgles2 libgl1-mesa-glx libgl1-mesa-dev \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

RUN cd /tmp && \
    wget -q https://www.sqlite.org/2024/sqlite-autoconf-3450000.tar.gz && \
    tar xzf sqlite-autoconf-3450000.tar.gz && \
    cd sqlite-autoconf-3450000 && \
    ./configure --prefix=/usr/local && make -j4 && make install && \
    ldconfig && rm -rf /tmp/sqlite-autoconf-3450000*

RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

RUN pip install --no-cache-dir \
    torch==2.11.0 torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu126

RUN pip install --no-cache-dir \
    "lerobot[smolvla]==0.6.1"

RUN pip install --no-cache-dir \
    vla-eval==0.4.0 \
    opencv-python

RUN pip install --no-cache-dir \
    "cmake==3.31.6" \
    && pip install --no-cache-dir \
    "robosuite==1.5.2" \
    robot_descriptions

ENV CMAKE_POLICY_VERSION_MINIMUM=3.5
RUN pip install --no-cache-dir --no-build-isolation egl_probe hf-egl-probe

RUN pip install --no-cache-dir \
    "bddl==1.0.1" easydict cloudpickle "gym==0.25.2" num2words future hydra-core einops \
    matplotlib wandb robomimic thop && \
    git clone --depth 1 --branch X-embodiment https://github.com/Lifelong-Robot-Learning/LIBERO.git /tmp/libero && \
    touch /tmp/libero/libero/__init__.py && \
    pip install --no-cache-dir -e /tmp/libero && \
    rm -rf /tmp/libero/.git

ENV MUJOCO_GL=egl
ENV HF_ENDPOINT=https://hf-mirror.com
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

WORKDIR /workspace
COPY scripts/ /workspace/scripts/
COPY configs/ /workspace/configs/
COPY robosuite_so101/ /workspace/robosuite_so101/

# Install SO101 MJCF assets into robosuite's asset directory
RUN ROBOSUITE_ASSETS=$(python -c "import robosuite; import os; print(os.path.join(os.path.dirname(robosuite.__file__), 'models', 'assets'))") && \
    mkdir -p $ROBOSUITE_ASSETS/robots/so101 && \
    mkdir -p $ROBOSUITE_ASSETS/grippers/so101_gripper_meshes && \
    cp /workspace/robosuite_so101/robots/so101/robot.xml $ROBOSUITE_ASSETS/robots/so101/ && \
    cp -r /workspace/robosuite_so101/robots/so101/meshes/* $ROBOSUITE_ASSETS/robots/so101/ && \
    cp /workspace/robosuite_so101/grippers/so101_gripper.xml $ROBOSUITE_ASSETS/grippers/ && \
    cp -r /workspace/robosuite_so101/grippers/meshes/* $ROBOSUITE_ASSETS/grippers/so101_gripper_meshes/

# Install SO101 controller config (v1.5 composite controller format)
RUN ROBOSUITE_CTRL=$(python -c "import robosuite; import os; print(os.path.join(os.path.dirname(robosuite.__file__), 'controllers', 'configs', 'robots'))") && \
    mkdir -p $ROBOSUITE_CTRL && \
    python -c "import json; json.dump({'arm': {'type': 'JOINT_POSITION', 'input_max': 1.0, 'input_min': -1.0, 'output_max': 0.5, 'output_min': -0.5, 'kp': 50.0, 'damping': 1.0, 'velocity_limits': [-1.0, 1.0], 'ramp_ratio': 0.2, 'interpolation': 'linear'}, 'gripper': {'type': 'POSITION', 'input_max': 1.0, 'input_min': -1.0, 'output_max': 0.1, 'output_min': -0.1, 'kp': 50.0, 'damping': 1.0, 'velocity_limits': [-1.0, 1.0]}}, open('$ROBOSUITE_CTRL/default_so101.json', 'w'))"

CMD ["python", "/workspace/scripts/eval_vla.py"]
