FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    git wget curl build-essential \
    libegl1 libgles2 libgl1-mesa-glx \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

# uv: required by `vla-eval serve` to spawn model servers
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN cd /tmp && \
    wget -q https://www.sqlite.org/2024/sqlite-autoconf-3450000.tar.gz && \
    tar xzf sqlite-autoconf-3450000.tar.gz && \
    cd sqlite-autoconf-3450000 && \
    ./configure --prefix=/usr/local && make -j4 && make install && \
    ldconfig && rm -rf /tmp/sqlite-autoconf-3450000*

RUN python3.12 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# Prefer /usr/local sqlite (3.45, built above) over Ubuntu 22.04 system 3.37:
# vla-eval>=0.4 requires SQLite>=3.38 (json_patch). LD_LIBRARY_PATH is
# resolved before the ld cache, so this beats cache-order issues.
ENV LD_LIBRARY_PATH="/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Fail the build (not the GPU run) if sqlite is still too old.
RUN python -c "import sqlite3; v=tuple(map(int, sqlite3.sqlite_version.split('.')))[:3]; assert v >= (3, 38, 0), sqlite3.sqlite_version; print('sqlite check OK:', sqlite3.sqlite_version)"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

RUN pip install --no-cache-dir \
    torch==2.11.0 torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu126

RUN pip install --no-cache-dir \
    "lerobot[smolvla]==0.6.1"

RUN pip install --no-cache-dir \
    vla-eval==0.4.0 \
    mujoco==3.3.2 \
    opencv-python

# LIBERO benchmark stack (in-process: vla-eval skips its own docker launch when
# already inside a container, so benchmark deps must live in THIS image).
# Proven block from the SO101 direct-eval lineage (robosuite 1.5.2).
RUN pip install --no-cache-dir \
    "cmake==3.31.6" \
    && pip install --no-cache-dir \
    "mujoco==3.3.1" \
    "robosuite==1.5.2" \
    robot_descriptions

ENV CMAKE_POLICY_VERSION_MINIMUM=3.5
RUN pip install --no-cache-dir --no-build-isolation egl_probe hf-egl-probe

RUN pip install --no-cache-dir \
    "bddl==1.0.1" easydict cloudpickle "gym==0.25.2" num2words future hydra-core einops \
    matplotlib wandb robomimic thop && \
    git clone --depth 1 --branch X-embodiment https://github.com/Lifelong-Robot-Learning/LIBERO.git /tmp/libero && \
    touch /tmp/libero/libero/__init__.py && \
    pip install --no-cache-dir -e /tmp/libero && \
    rm -rf /tmp/libero/.git

# Pre-seed LIBERO config non-interactively (first `import libero` prompts
# "custom path for the dataset folder? (Y/N)" and dies with EOFError when
# stdin is closed). Answering "n" writes package-relative defaults.
RUN yes n | python -c "import libero.libero; print('libero config seeded OK')" && \
    cat /root/.libero/config.yaml

# LIBERO-PRO overlay (perturbation suites, pure addition):
# Zxy-MLlab/LIBERO-PRO is a file-level superset of official LIBERO for
# bddl_files+init_files (385 overlapping files byte-identical, verified
# 2026-09-12), plus suite registration (task map + benchmark classes).
# Base package stays official X-embodiment; shared code (envs/) untouched,
# so robosuite-1.5 compat patches and X-embodiment keep working. Pinned.
ARG LIBERO_PRO_REF=eafdb809426b13153aa1e4c42d6601844217dfec
RUN git clone --depth 1 https://github.com/Zxy-MLlab/LIBERO-PRO.git /tmp/libero-pro && \
    cd /tmp/libero-pro && git fetch -q --depth 1 origin "${LIBERO_PRO_REF}" && git checkout -q FETCH_HEAD && \
    cp -r /tmp/libero-pro/libero/libero/bddl_files/. /tmp/libero/libero/libero/bddl_files/ && \
    cp -r /tmp/libero-pro/libero/libero/init_files/. /tmp/libero/libero/libero/init_files/ && \
    cp /tmp/libero-pro/libero/libero/benchmark/libero_suite_task_map.py /tmp/libero/libero/libero/benchmark/libero_suite_task_map.py && \
    cp /tmp/libero-pro/libero/libero/benchmark/__init__.py /tmp/libero/libero/libero/benchmark/__init__.py && \
    cp /tmp/libero-pro/libero/libero/envs/objects/self_designed_object.py /tmp/libero/libero/libero/envs/objects/self_designed_object.py && \
    cd / && python -c "from libero.libero.benchmark import get_benchmark; get_benchmark('libero_spatial_env'); get_benchmark('libero_spatial'); print('PRO overlay OK')" && \
    rm -rf /tmp/libero-pro

# PRO assets (new objects only): cp -rn so shared meshes/textures stay
# byte-identical to official. Verified 2026-09-12: 585 overlapping assets,
# only 2 differ (kitchen/study scene style xmls) — excluded via no-clobber
# to protect the 47% visual baseline.
# PRO object registration: fork's objects/__init__.py (official + 1 import)
# + 4 object files whose diffs are verified pure-addition (0 deletions).
# Plus fork's base_object.py: identical except register_object tolerates
# duplicates via try/except (the fork defines RedAlphabetSoup twice;
# official asserts hard). Zero behavior change for standard suites
# (no dupes there) — faithful to upstream.
RUN git clone --depth 1 https://github.com/Zxy-MLlab/LIBERO-PRO.git /tmp/libero-pro && \
    cd /tmp/libero-pro && git fetch -q --depth 1 origin "${LIBERO_PRO_REF}" && git checkout -q FETCH_HEAD && \
    cp -rn /tmp/libero-pro/libero/libero/assets/. /tmp/libero/libero/libero/assets/ && \
    cp /tmp/libero-pro/libero/libero/envs/objects/__init__.py /tmp/libero/libero/libero/envs/objects/__init__.py && \
    cp /tmp/libero-pro/libero/libero/envs/objects/hope_objects.py /tmp/libero/libero/libero/envs/objects/hope_objects.py && \
    cp /tmp/libero-pro/libero/libero/envs/objects/google_scanned_objects.py /tmp/libero/libero/libero/envs/objects/google_scanned_objects.py && \
    cp /tmp/libero-pro/libero/libero/envs/objects/articulated_objects.py /tmp/libero/libero/libero/envs/objects/articulated_objects.py && \
    cp /tmp/libero-pro/libero/libero/envs/objects/turbosquid_objects.py /tmp/libero/libero/libero/envs/objects/turbosquid_objects.py && \
    cp /tmp/libero-pro/libero/libero/envs/base_object.py /tmp/libero/libero/libero/envs/base_object.py && \
    cd / && python -c "from libero.libero.envs.objects import get_object_dict; d=get_object_dict(); assert 'libero_mug_yellow' in d, sorted(d)[:5]; print('PRO objects OK:', len(d), 'registered')" && \
    rm -rf /tmp/libero-pro

ENV MUJOCO_GL=egl
ENV HF_ENDPOINT=https://hf-mirror.com
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

WORKDIR /workspace
COPY scripts/ /workspace/scripts/
COPY configs/ /workspace/configs/

# `vla-eval serve` runs the server script via `uv run <script>`. Make uv reuse
# this venv (not a fresh python) and stage the server script with its PEP 723
# metadata stripped (upstream pins CPU torch + git lerobot, which would shadow
# this image's CUDA venv; all deps are already installed here).
ENV VIRTUAL_ENV=/opt/venv
ENV UV_NO_PROJECT=1
RUN SITE_PKGS=$(python -c "import site; print(site.getsitepackages()[0])") && \
    mkdir -p /workspace/model_servers && \
    sed '/^# \/\/\/ script/,/^# \/\/\/$/d' "$SITE_PKGS/vla_eval/model_servers/lerobot.py" \
      > /workspace/model_servers/lerobot.py && \
    grep -c "PEP 723\|/// script" /workspace/model_servers/lerobot.py || \
      echo "server script staged OK (metadata stripped)"

CMD ["python", "/workspace/scripts/eval_vla.py"]
