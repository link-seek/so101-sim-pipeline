FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y \
    python3.12 python3-pip python3-venv \
    git wget curl \
    libegl1 libgles2 libgl1-mesa-glx \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3.12 /usr/bin/python3

RUN pip3 install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cu128

RUN pip3 install --no-cache-dir \
    mujoco opencv-python huggingface_hub

ENV MUJOCO_GL=egl
ENV HF_ENDPOINT=https://hf-mirror.com

WORKDIR /data/pipeline
COPY scripts/eval_so101_mujoco.py /data/pipeline/
COPY scripts/run_eval.sh /data/pipeline/

CMD ["/bin/bash", "/data/pipeline/run_eval.sh"]
